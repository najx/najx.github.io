---
layout: none
---

{%- assign entries = site.posts | concat: site.ai_news | sort: "date" | reverse -%}
[
  {% for post in entries %}
    {
      "title"    : "{{ post.title | escape }}",
      "description" : "{{ post.description | escape }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date }}"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
